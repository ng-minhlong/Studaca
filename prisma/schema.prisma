  testTakerCount       Int      @map("test_taker_count")
  numberQuestion       Int      @map("number_question")
  testType             String   @map("test_type")
  createdAt            DateTime @map("created_at")
  allowPreviewQuestion Int      @default(0) @map("allow_preview_question")

  @@map("hsk_test_list")
}

model HskTestPartList {
